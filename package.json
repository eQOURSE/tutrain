{
  "name": "tutrain",
  "private": true,
  "description": "Tutrain v2 monorepo",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:docs": "node --test \"tools/docs-check/*.test.mjs\"",
    "test:workspace": "node --test \"tools/workspace-check/*.test.mjs\"",
    "test": "pnpm test:docs && pnpm test:workspace && pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
